{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App: Play",
      "type": "debugpy",
      "request": "launch",
      "module": "pyghostboard.cli",
      "args": [
        "play",
        "--seed",
        "7"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Environment: Sync"
    },
    {
      "name": "Arena: Watch Example",
      "type": "debugpy",
      "request": "launch",
      "module": "pyghostboard.cli",
      "args": [
        "arena",
        "watch",
        "examples/arena.toml",
        "--agent",
        "mcts",
        "--opponent",
        "random"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Environment: Sync"
    },
    {
      "name": "Arena: Run Example",
      "type": "debugpy",
      "request": "launch",
      "module": "pyghostboard.cli",
      "args": [
        "arena",
        "run",
        "examples/arena.toml",
        "--output",
        "${input:arenaOutput}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Environment: Sync"
    },
    {
      "name": "Arena: Resume",
      "type": "debugpy",
      "request": "launch",
      "module": "pyghostboard.cli",
      "args": [
        "arena",
        "resume",
        "${input:arenaOutput}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Environment: Sync"
    },
    {
      "name": "Tests: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Environment: Sync"
    }
  ],
  "inputs": [
    {
      "id": "arenaOutput",
      "type": "promptString",
      "description": "Private arena output directory",
      "default": ".pyghostboard/arena/manual-run"
    }
  ]
}
