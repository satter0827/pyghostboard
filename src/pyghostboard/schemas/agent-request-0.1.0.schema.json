{
  "$defs": {
    "ActionRequest": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "action_request",
          "default": "action_request",
          "title": "Type",
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/PlayerView"
        }
      },
      "required": [
        "request_id",
        "view"
      ],
      "title": "ActionRequest",
      "type": "object"
    },
    "CapturedPiece": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/GhostKind"
        },
        "owner": {
          "$ref": "#/$defs/Player"
        }
      },
      "required": [
        "owner",
        "kind"
      ],
      "title": "CapturedPiece",
      "type": "object"
    },
    "Escape": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Square"
        },
        "type": {
          "const": "escape",
          "default": "escape",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Escape",
      "type": "object"
    },
    "Exit": {
      "additionalProperties": false,
      "properties": {
        "square": {
          "$ref": "#/$defs/Square"
        }
      },
      "required": [
        "square"
      ],
      "title": "Exit",
      "type": "object"
    },
    "FinishedRequest": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "finished",
          "default": "finished",
          "title": "Type",
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/PlayerView"
        }
      },
      "required": [
        "request_id",
        "view"
      ],
      "title": "FinishedRequest",
      "type": "object"
    },
    "GameOutcome": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/OutcomeReason"
        },
        "winner": {
          "$ref": "#/$defs/Player"
        }
      },
      "required": [
        "winner",
        "reason"
      ],
      "title": "GameOutcome",
      "type": "object"
    },
    "GhostKind": {
      "enum": [
        "good",
        "bad"
      ],
      "title": "GhostKind",
      "type": "string"
    },
    "InitializeRequest": {
      "additionalProperties": false,
      "properties": {
        "player": {
          "$ref": "#/$defs/Player"
        },
        "protocol_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "rules": {
          "$ref": "#/$defs/RuleSet"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "type": {
          "const": "initialize",
          "default": "initialize",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "seed",
        "player",
        "rules"
      ],
      "title": "InitializeRequest",
      "type": "object"
    },
    "Move": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "$ref": "#/$defs/Square"
        },
        "source": {
          "$ref": "#/$defs/Square"
        },
        "type": {
          "const": "move",
          "default": "move",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "source",
        "destination"
      ],
      "title": "Move",
      "type": "object"
    },
    "OutcomeReason": {
      "enum": [
        "escape",
        "capture_good",
        "sacrifice_bad"
      ],
      "title": "OutcomeReason",
      "type": "string"
    },
    "OwnPiece": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GhostKind"
        },
        "square": {
          "$ref": "#/$defs/Square"
        }
      },
      "required": [
        "id",
        "kind",
        "square"
      ],
      "title": "OwnPiece",
      "type": "object"
    },
    "Player": {
      "enum": [
        "one",
        "two"
      ],
      "title": "Player",
      "type": "string"
    },
    "PlayerView": {
      "additionalProperties": false,
      "properties": {
        "captured": {
          "items": {
            "$ref": "#/$defs/CapturedPiece"
          },
          "title": "Captured",
          "type": "array"
        },
        "current_player": {
          "$ref": "#/$defs/Player"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "legal_actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "escape": "#/$defs/Escape",
                "move": "#/$defs/Move"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Move"
              },
              {
                "$ref": "#/$defs/Escape"
              }
            ]
          },
          "title": "Legal Actions",
          "type": "array"
        },
        "match_id": {
          "format": "uuid",
          "title": "Match Id",
          "type": "string"
        },
        "opponent_squares": {
          "items": {
            "$ref": "#/$defs/Square"
          },
          "title": "Opponent Squares",
          "type": "array"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "own_pieces": {
          "items": {
            "$ref": "#/$defs/OwnPiece"
          },
          "title": "Own Pieces",
          "type": "array"
        },
        "player": {
          "$ref": "#/$defs/Player"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "match_id",
        "revision",
        "player",
        "current_player",
        "width",
        "height",
        "own_pieces",
        "opponent_squares",
        "captured",
        "legal_actions",
        "outcome"
      ],
      "title": "PlayerView",
      "type": "object"
    },
    "RuleSet": {
      "additionalProperties": false,
      "properties": {
        "bad_count": {
          "minimum": 1,
          "title": "Bad Count",
          "type": "integer"
        },
        "format_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Format Version",
          "type": "string"
        },
        "good_count": {
          "minimum": 1,
          "title": "Good Count",
          "type": "integer"
        },
        "height": {
          "maximum": 26,
          "minimum": 2,
          "title": "Height",
          "type": "integer"
        },
        "movement": {
          "items": {
            "$ref": "#/$defs/Vector"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Movement",
          "type": "array"
        },
        "player_one_exits": {
          "items": {
            "$ref": "#/$defs/Exit"
          },
          "title": "Player One Exits",
          "type": "array"
        },
        "player_one_start": {
          "items": {
            "$ref": "#/$defs/Square"
          },
          "title": "Player One Start",
          "type": "array"
        },
        "player_two_exits": {
          "items": {
            "$ref": "#/$defs/Exit"
          },
          "title": "Player Two Exits",
          "type": "array"
        },
        "player_two_start": {
          "items": {
            "$ref": "#/$defs/Square"
          },
          "title": "Player Two Start",
          "type": "array"
        },
        "victory_conditions": {
          "default": [
            "escape",
            "capture_good",
            "sacrifice_bad"
          ],
          "items": {
            "$ref": "#/$defs/OutcomeReason"
          },
          "title": "Victory Conditions",
          "type": "array"
        },
        "width": {
          "maximum": 26,
          "minimum": 2,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "good_count",
        "bad_count",
        "player_one_start",
        "player_two_start",
        "player_one_exits",
        "player_two_exits",
        "movement"
      ],
      "title": "RuleSet",
      "type": "object"
    },
    "SetupRequest": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "setup_request",
          "default": "setup_request",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "SetupRequest",
      "type": "object"
    },
    "Square": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "exclusiveMaximum": 26,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "exclusiveMaximum": 26,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Square",
      "type": "object"
    },
    "Vector": {
      "additionalProperties": false,
      "properties": {
        "dx": {
          "title": "Dx",
          "type": "integer"
        },
        "dy": {
          "title": "Dy",
          "type": "integer"
        }
      },
      "required": [
        "dx",
        "dy"
      ],
      "title": "Vector",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/satter0827/pyghostboard/v0.1.0/src/pyghostboard/schemas/agent-request-0.1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "action_request": "#/$defs/ActionRequest",
      "finished": "#/$defs/FinishedRequest",
      "initialize": "#/$defs/InitializeRequest",
      "setup_request": "#/$defs/SetupRequest"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/InitializeRequest"
    },
    {
      "$ref": "#/$defs/SetupRequest"
    },
    {
      "$ref": "#/$defs/ActionRequest"
    },
    {
      "$ref": "#/$defs/FinishedRequest"
    }
  ]
}
